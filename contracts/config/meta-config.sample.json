    }
  },
  "Quota": {
    "MaxUsersCount": 0,
    "MaxItemsCount": 0,
    "MaxLabelsSize": 0,
    "MaxCommentSize": 0,
    "MaxCategoriesCount": 0,
    "MaxCategoriesSize": 0
  }
}
