+//! Profiling aid for D-372 (not part of the pinned checker's logic). It reports, on stderr,
+//! the declarations that take at least a second, and a heartbeat every minute with the
+//! count of finished declarations and the one in flight. Names are printed as NamePtr
+//! indices, which are the export's name ids.
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+pub(crate) static INFLIGHT: Mutex<Option<(String, Instant)>> = Mutex::new(None);
+pub(crate) static DONE: AtomicUsize = AtomicUsize::new(0);
+pub(crate) static STOP: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn started(name: &str) {
+    *INFLIGHT.lock().unwrap() = Some((name.to_string(), Instant::now()));
+}
+
+pub(crate) fn finished(name: &str, start: Instant) {
+    let ms = start.elapsed().as_millis();
+    if ms >= 1000 {
+        eprintln!("DIAG slow name={} ms={}", name, ms);
+    }
+    DONE.fetch_add(1, Ordering::Relaxed);
+    *INFLIGHT.lock().unwrap() = None;
+}
+
+pub(crate) fn start_heartbeat(total: usize) {
+    let t0 = Instant::now();
+    std::thread::spawn(move || {
+        while !STOP.load(Ordering::Relaxed) {
+            std::thread::sleep(Duration::from_secs(60));
+            let done = DONE.load(Ordering::Relaxed);
+            let inflight = INFLIGHT.lock().unwrap().clone();
+            match inflight {
+                Some((n, s)) => eprintln!(
+                    "DIAG heartbeat t={}s done={}/{} inflight={} for={}s",
+                    t0.elapsed().as_secs(), done, total, n, s.elapsed().as_secs()
+                ),
+                None => eprintln!("DIAG heartbeat t={}s done={}/{} inflight=none", t0.elapsed().as_secs(), done, total),
+            }
+        }
+    });
+}
