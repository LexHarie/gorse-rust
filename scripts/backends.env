# Backend URIs for the gate (scripts/gate.sh) and the parity suites (scripts/parity.sh).
# They match the local test containers of storage/docker-compose.yml. The
# credentials are throwaway values for those containers only. Each line sets a
# default; a variable already set in the environment wins.
: "${REDIS_URI:=redis://127.0.0.1:6379/}"
: "${MYSQL_URI:=mysql://gorse:gorse_pass@127.0.0.1:3306/gorse}"
: "${POSTGRES_URI:=postgres://gorse:gorse_pass@127.0.0.1:5432/}"
: "${MONGO_URI:=mongodb://root:password@127.0.0.1:27017/?authSource=admin}"
: "${QDRANT_URI:=http://127.0.0.1:6334}"
: "${MILVUS_URI:=milvus://127.0.0.1:19530}"
: "${WEAVIATE_URI:=weaviate://127.0.0.1:8080}"
: "${S3_ENDPOINT:=127.0.0.1:9000}"
: "${S3_ACCESS_KEY_ID:=rustfsadmin}"
: "${S3_SECRET_ACCESS_KEY:=rustfsadmin}"
# The Azurite emulator's well-known development account (published by Microsoft;
# it protects nothing). The blob test reads it as AZURE_STORAGE_CONNECTION_STRING.
: "${AZURE_STORAGE_CONNECTION_STRING:=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;}"
export REDIS_URI MYSQL_URI POSTGRES_URI MONGO_URI QDRANT_URI MILVUS_URI WEAVIATE_URI
export S3_ENDPOINT S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY AZURE_STORAGE_CONNECTION_STRING
