# Pins for the independent checks (G2), read by scripts/check-kernels.sh. Each
# revision is a commit, and the script refuses a checkout that resolves to another.
#
#   lean4checker  the tag v4.15.0, the project's Lean toolchain.
#   nanoda        the tag v0.3.2. Its Cargo.lock is used with --locked.
#
# lean4export is not fetched. Its copy in kernel/lean4export is vendored, and
# kernel/lean4export/NOTICE.md records where it came from and what changed.
LEAN4CHECKER_REPO=https://github.com/leanprover/lean4checker.git
LEAN4CHECKER_REV=be02a4748128f9bf6a192f4c3b000464f99b062f
NANODA_REPO=https://github.com/ammkrn/nanoda_lib.git
NANODA_REV=66cca78149555a92b7d7a919acd88d3878b83302
