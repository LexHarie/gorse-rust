# Pins for the Aeneas spike (P1-3), read by scripts/aeneas-spike.sh.
#
# AENEAS_REV and its digest come from the discover run on PR #9 (CI). The Charon
# revision is the one named by Aeneas's own charon-pin file, which the build
# reads; CHARON_REV is left empty until that run has printed it.
#
# The digest of a revision is sha256 of `git archive --format=tar HEAD`.
AENEAS_REPO=https://github.com/AeneasVerif/aeneas
AENEAS_REV=c2d234386474622b6aeda5add0e95ff995f49210
AENEAS_TREE_SHA256=4196510beda034998fbe685819f099262beb19fe9f89224b906d08d12c921026

CHARON_REPO=https://github.com/AeneasVerif/charon
CHARON_REV=
CHARON_TREE_SHA256=
